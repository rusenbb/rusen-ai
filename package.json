{
  "name": "rusen-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.6.0",
    "npm": ">=11.6.2 <12"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "$sharp",
    "protobufjs": "7.6.5"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-steering-runtime.mjs && npm run content:check && npm run social:verify",
    "build": "next build",
    "postbuild": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/social-verify-export.ts",
    "start": "serve out",
    "lint": "eslint",
    "social:create": "./bin/social-create",
    "social:create:all": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/social-create-all.ts",
    "social:build": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/social-build.ts",
    "social:verify": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/social-build.ts --verify",
    "photos:build": "tsx scripts/photos-build.ts",
    "photos:add": "tsx scripts/photos-build.ts --merge",
    "photos:verify": "tsx scripts/photos-verify.ts",
    "photos:prune:dry-run": "tsx scripts/photos-verify.ts --dry-run",
    "photos:prune": "tsx scripts/photos-verify.ts --prune",
    "content:check": "tsx scripts/content-check.ts && tsx scripts/projects-doc.ts --verify && npm run photos:verify",
    "projects:docs": "tsx scripts/projects-doc.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:smoke": "playwright test",
    "cv:build": "uv run --script scripts/render_cv.py",
    "train:adaptive-arena": "uv run python scripts/train_adaptive_arena.py",
    "train:adaptive-arena:deps": "uv sync && uv pip install --reinstall torch==2.10.0 --torch-backend=cu128",
    "train:adaptive-arena:ts": "tsx scripts/train-adaptive-arena.ts",
    "deploy": "npx --yes --package=wrangler@4.114.0 wrangler pages deploy ./out",
    "verify:arena": "tsx scripts/arena-parity.ts output/arena-parity-input.json && uv run --no-sync python scripts/check_arena_parity.py output/arena-parity-input.json",
    "typecheck": "tsc --noEmit",
    "benchmark:tokenizer": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/tokenizer-benchmark.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0-next.6",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.46",
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "onnx-proto": "8.0.1",
    "onnxruntime-web": "1.25.0-dev.20260303-e7e64dc112",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "tiktoken": "^1.0.22",
    "umap-js": "^1.4.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^27.4.0",
    "onnxruntime-node": "1.24.3",
    "serve": "14.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
